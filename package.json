{
  "name": "@meteora-ag/zap-sdk",
  "version": "1.3.0",
  "description": "A Typescript SDK for interacting with the Zap program on Meteora.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "source": "src/index.ts",
  "types": "dist/index.d.ts",
  "author": "Minh Do <minh@raccoons.dev>, Dann Wee <dann@raccoons.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeteoraAg/zap-sdk.git"
  },
  "keywords": [
    "meteora-ag",
    "zap",
    "damm-v2",
    "dlmm",
    "jupiter"
  ],
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf dist && rm -rf node_modules rm -rf pnpm-lock.yaml",
    "typecheck": "tsc",
    "format": "prettier --check .",
    "test": "ts-mocha --no-experimental-strip-types -p ./tsconfig.json -t 1000000 'tests/**/*.test.ts'"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/invariant": "^2.2.37",
    "@types/mocha": "^9.0.0",
    "bip39": "^3.1.0",
    "chai": "^4.3.4",
    "ed25519-hd-key": "^1.3.0",
    "litesvm": "^0.6.0",
    "mocha": "^9.0.3",
    "prettier": "^3.8.2",
    "ts-mocha": "^10.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@meteora-ag/cp-amm-sdk": "^1.4.0",
    "@meteora-ag/dlmm": "^1.9.7",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "bn.js": "^5.2.2",
    "decimal.js": "^10.4.2",
    "invariant": "^2.2.4"
  },
  "packageManager": "pnpm@10.33.1+sha512.05ba3c1d5d1c18f68df06470d74055e62d41fc110a0c660db1b2dfb2785327f04cf0f68345d4609bc52089e7fa0343c31593b2f9594e2c5d5da426230acc9820"
}
